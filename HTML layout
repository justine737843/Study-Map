<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Canada Courses App</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <h1>Canada Courses Explorer</h1>

  <div class="filters">
    <label>
      Province:
      <select id="provinceSelect">
        <option value="">Select province</option>
      </select>
    </label>

    <label>
      Grade:
      <select id="gradeSelect">
        <option value="">Select grade</option>
      </select>
    </label>
  </div>

  <div id="coursesList"></div>

  <div id="courseDetails" class="hidden">
    <h2 id="courseName"></h2>
    <p><strong>Type:</strong> <span id="courseType"></span></p>

    <h3>Teaching Video</h3>
    <div id="videoSection">
      <a id="videoLink" href="#" target="_blank">Open video</a>
    </div>

    <h3>Study Guide</h3>
    <p id="studyGuide"></p>

    <h3>Textbook Pages</h3>
    <p id="textbookPages"></p>

    <h3>Practice Tests</h3>
    <ul id="practiceTestsList"></ul>

    <h3>Student Notes</h3>
    <p class="note-info">
      (In a real app, this would save to a database. For now, it just stays in your browser.)
    </p>
    <textarea id="notesInput" placeholder="Write or paste your notes here..."></textarea>
    <button id="saveNotesBtn">Save Notes (Local)</button>
    <div id="savedNotes"></div>
  </div>

  <script src="coursesData.js"></script>
  <script src="app.js"></script>
</body>
</html>
