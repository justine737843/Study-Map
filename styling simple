body {
  font-family: system-ui, sans-serif;
  max-width: 900px;
  margin: 30px auto;
  padding: 0 16px;
}

h1 {
  text-align: center;
}

.filters {
  display: flex;
  gap: 16px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

label {
  display: flex;
  flex-direction: column;
  font-size: 14px;
}

select {
  padding: 6px;
  margin-top: 4px;
}

#coursesList {
  margin-top: 10px;
  margin-bottom: 20px;
}

.course-item {
  border: 1px solid #ddd;
  padding: 10px;
  margin-bottom: 8px;
  cursor: pointer;
}

.course-item:hover {
  background: #f5f5f5;
}

.hidden {
  display: none;
}

#courseDetails {
  border-top: 2px solid #333;
  padding-top: 20px;
}

#notesInput {
  width: 100%;
  min-height: 120px;
  margin-bottom: 8px;
}

#saveNotesBtn {
  padding: 6px 12px;
  cursor: pointer;
}

#savedNotes {
  margin-top: 10px;
  padding: 8px;
  background: #f9f9f9;
  border: 1px solid #eee;
  white-space: pre-wrap;
}

.note-info {
  font-size: 12px;
  color: #666;
}
